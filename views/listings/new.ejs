<% layout("/layouts/boilerplate.ejs") %>

<section class="container rn-container rn-form-wrap">
  <div class="rn-form-card">
    <p class="rn-eyebrow">Become a host</p>
    <h1 class="rn-page-title">List your property</h1>
    <p class="rn-page-sub">Tell guests what makes your place special.</p>

    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
      <div class="mb-4">
        <label for="title" class="form-label">Title</label>
        <input id="title" name="listing[title]" class="form-control" placeholder="e.g. Clifftop villa above the bay" type="text" required>
        <div class="invalid-feedback">Please add a title.</div>
      </div>

      <div class="mb-4">
        <label for="description" class="form-label">Description</label>
        <textarea id="description" name="listing[description]" rows="5" class="form-control" placeholder="Describe the space, the views and the neighbourhood" required></textarea>
        <div class="invalid-feedback">Please enter a short description.</div>
      </div>

      <div class="mb-4">
        <label for="image" class="form-label">Cover photo</label>
        <input id="image" name="listing[image]" type="file" accept="image/png,image/jpeg" class="form-control" data-preview="#imagePreview" required>
        <div class="invalid-feedback">Please choose a photo (JPG or PNG).</div>
        <img id="imagePreview" class="rn-upload-preview" alt="Selected photo preview" hidden>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-6">
          <label for="category" class="form-label">Category</label>
          <select id="category" name="listing[category]" class="form-select" required>
            <option value="" selected disabled>Choose a category</option>
            <% categories.forEach(function (c) { %>
              <option value="<%= c.key %>"><%= c.label %></option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Please choose a category.</div>
        </div>
        <div class="col-md-6">
          <label for="price" class="form-label">Price per night (&#8377;)</label>
          <input id="price" name="listing[price]" type="number" min="0" placeholder="12000" class="form-control" required>
          <div class="invalid-feedback">Enter a valid price.</div>
        </div>
      </div>

      <div class="row g-3 mb-4">
        <div class="col-md-7">
          <label for="location" class="form-label">Location</label>
          <input id="location" name="listing[location]" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required>
          <div class="invalid-feedback">Please enter a location.</div>
        </div>
        <div class="col-md-5">
          <label for="country" class="form-label">Country</label>
          <input id="country" name="listing[country]" placeholder="India" type="text" class="form-control" required>
          <div class="invalid-feedback">Please enter a country.</div>
        </div>
      </div>

      <div class="rn-form-actions">
        <a href="/listings" class="rn-btn rn-btn-ghost">Cancel</a>
        <button class="rn-btn rn-btn-primary">Publish listing</button>
      </div>
    </form>
  </div>
</section>
