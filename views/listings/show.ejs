<% layout("/layouts/boilerplate.ejs") %>
<%
    const isOwnerView = Boolean(currUser && listing.owner && listing.owner._id.equals(currUser._id));
    const showCat = categories.find(function (c) { return c.key === listing.category; });
    const showSaved = wishlistIds.includes(String(listing._id));
    const hostName = listing.owner ? listing.owner.username : "RoamNest host";
    const heroImg = listing.image && listing.image.url ? listing.image.url : "/img/placeholder.svg";
    const nightlyPrice = Number(listing.price) || 0;
    const clientData = {
        mapToken: process.env.MAP_TOKEN || "",
        listing: { title: listing.title, location: listing.location, geometry: listing.geometry }
    };
%>
<script>
    // Only the fields the browser needs. "<" is escaped so the JSON can never close the script tag.
    window.RN = <%- JSON.stringify(clientData).replace(/</g, "\\u003c") %>;
</script>

<section class="container rn-container rn-show">

  <!-- ============ Header ============ -->
  <div class="rn-show-head">
    <a class="rn-back" href="/listings"><i class="fa-solid fa-arrow-left"></i> All stays</a>
    <div class="rn-show-titlebar">
      <div>
        <h1><%= listing.title %></h1>
        <p class="rn-show-meta">
          <% if (reviewCount) { %>
            <span><i class="fa-solid fa-star"></i> <strong><%= avgRating.toFixed(1) %></strong> (<%= reviewCount %> <%= reviewCount === 1 ? "review" : "reviews" %>)</span>
            <span class="rn-dot">&bull;</span>
          <% } %>
          <span><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></span>
          <% if (showCat) { %>
            <span class="rn-dot">&bull;</span>
            <a class="rn-chip rn-chip-inline" href="/listings?category=<%= showCat.key %>"><i class="fa-solid <%= showCat.icon %>"></i> <%= showCat.label %></a>
          <% } %>
        </p>
      </div>
      <div class="rn-show-actions">
        <form method="POST" action="/listings/<%= listing._id %>/wishlist" data-wishlist-form>
          <button type="submit" class="rn-save-btn <%= showSaved ? 'is-saved' : '' %>" aria-pressed="<%= showSaved %>">
            <i class="<%= showSaved ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
            <span class="rn-save-label"><%= showSaved ? "Saved" : "Save" %></span>
          </button>
        </form>
        <% if (isOwnerView) { %>
          <a href="/listings/<%= listing._id %>/edit" class="rn-btn rn-btn-ghost"><i class="fa-solid fa-pen"></i> Edit</a>
          <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" onsubmit="return confirm('Delete this listing permanently?');">
            <button class="rn-btn rn-btn-danger"><i class="fa-solid fa-trash"></i> Delete</button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <div class="rn-show-photo">
    <img src="<%= heroImg %>" alt="<%= listing.title %>" onerror="this.onerror=null;this.src='/img/placeholder.svg'">
  </div>

  <div class="rn-show-grid">

    <!-- ============ Main column ============ -->
    <div class="rn-show-main">
      <div class="rn-host">
        <span class="rn-avatar rn-avatar-lg"><%= hostName.charAt(0).toUpperCase() %></span>
        <div>
          <h2>Hosted by <%= hostName %></h2>
          <p><%= listing.location %>, <%= listing.country %></p>
        </div>
      </div>

      <hr class="rn-rule">

      <h2 class="rn-h2">About this place</h2>
      <p class="rn-about"><%= listing.description %></p>

      <hr class="rn-rule">

      <h2 class="rn-h2">Where you'll be</h2>
      <div id="map" aria-label="Map showing the location of <%= listing.title %>"></div>
      <p class="rn-map-note" id="mapNote" hidden>Map unavailable.</p>

      <hr class="rn-rule">

      <!-- ============ Reviews ============ -->
      <h2 class="rn-h2">
        Reviews
        <% if (reviewCount) { %><span class="rn-h2-meta"><i class="fa-solid fa-star"></i> <%= avgRating.toFixed(1) %> &middot; <%= reviewCount %></span><% } %>
      </h2>

      <% if (currUser) { %>
        <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation rn-review-form">
          <h3>Leave a review</h3>
          <fieldset class="starability-slot">
            <legend class="visually-hidden">Rating</legend>
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
          <div class="mb-3">
            <label for="comment" class="form-label">Your experience</label>
            <textarea name="review[comment]" id="comment" rows="4" class="form-control" required></textarea>
            <div class="invalid-feedback">Please add a few words about your stay.</div>
          </div>
          <button class="rn-btn rn-btn-primary">Post review</button>
        </form>
      <% } else { %>
        <p class="rn-login-hint"><a href="/login">Log in</a> to leave a review.</p>
      <% } %>

      <% if (listing.reviews.length > 0) { %>
        <div class="rn-reviews">
          <% listing.reviews.forEach(function (review) {
               const author = review.author ? review.author.username : "Guest";
               const mine = currUser && review.author && review.author._id.equals(currUser._id);
          %>
            <article class="rn-review">
              <header>
                <span class="rn-avatar"><%= author.charAt(0).toUpperCase() %></span>
                <div>
                  <h4>@<%= author %></h4>
                  <% if (review.createdAt) { %><time><%= new Date(review.createdAt).toLocaleDateString("en-GB", { month: "short", year: "numeric" }) %></time><% } %>
                </div>
              </header>
              <p class="starability-result" data-rating="<%= review.rating %>">Rated: <%= review.rating %> stars</p>
              <p class="rn-review-text"><%= review.comment %></p>
              <% if (mine) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="rn-link-btn">Delete</button>
                </form>
              <% } %>
            </article>
          <% }) %>
        </div>
      <% } else { %>
        <p class="rn-login-hint">No reviews yet. Be the first to share your stay.</p>
      <% } %>
    </div>

    <!-- ============ Booking card with dynamic pricing ============ -->
    <aside class="rn-show-side">
      <div class="rn-book" id="booking" data-nightly="<%= nightlyPrice %>" data-fee-rate="0.10" data-logged-in="<%= currUser ? 'true' : 'false' %>">
        <div class="rn-book-price">
          <strong>&#8377;<%= nightlyPrice.toLocaleString("en-IN") %></strong> <span>/ night</span>
        </div>

        <div class="rn-book-fields">
          <label class="rn-field">
            <span>Check-in</span>
            <input type="date" id="checkIn" autocomplete="off">
          </label>
          <label class="rn-field">
            <span>Check-out</span>
            <input type="date" id="checkOut" autocomplete="off">
          </label>
          <label class="rn-field rn-field-full">
            <span>Guests</span>
            <select id="guests">
              <% for (let g = 1; g <= 8; g++) { %>
                <option value="<%= g %>"><%= g %> <%= g === 1 ? "guest" : "guests" %></option>
              <% } %>
            </select>
          </label>
        </div>

        <p class="rn-book-hint" id="bookHint">Choose your dates to see the full price.</p>

        <table class="rn-breakdown" id="breakdown" hidden>
          <tbody>
            <tr>
              <td id="bdLabel">&#8377;0 &times; 0 nights</td>
              <td class="num" id="bdSubtotal">&#8377;0</td>
            </tr>
            <tr>
              <td id="bdFeeLabel">Service fee (10%)</td>
              <td class="num" id="bdFee">&#8377;0</td>
            </tr>
            <tr class="total">
              <th scope="row">Total</th>
              <td class="num" id="bdTotal">&#8377;0</td>
            </tr>
          </tbody>
        </table>

        <button type="button" class="rn-btn rn-btn-primary rn-btn-block" id="reserveBtn" disabled>Reserve</button>
        <p class="rn-book-note">You won't be charged yet</p>
        <div class="rn-book-msg" id="reserveMsg" role="status" hidden></div>
      </div>
    </aside>
  </div>
</section>

<script src="/js/pricing.js"></script>
<script src="/js/map.js"></script>
