<% layout("/layouts/boilerplate.ejs") %>

<section class="rn-auth">
  <div class="rn-auth-art" style="background-image: linear-gradient(160deg, rgba(20,23,26,.35), rgba(20,23,26,.85)), url('https://images.unsplash.com/photo-1439066615861-d1af74d74000?auto=format&fit=crop&w=1400&q=70');">
    <div>
      <p class="rn-eyebrow">Join RoamNest</p>
      <h2>Save the places you love. Host the ones you own.</h2>
    </div>
  </div>
  <div class="rn-auth-form">
    <div class="rn-auth-inner">
      <h1 class="rn-page-title">Create your account</h1>
      <p class="rn-page-sub">Already a member? <a href="/login">Log in</a></p>

      <form action="/signup" method="POST" novalidate class="needs-validation">
        <div class="mb-4">
          <label for="username" class="form-label">Username</label>
          <input name="username" id="username" class="form-control" type="text" autocomplete="username" required>
          <div class="invalid-feedback">Please choose a username.</div>
        </div>
        <div class="mb-4">
          <label for="email" class="form-label">Email</label>
          <input name="email" id="email" class="form-control" type="email" autocomplete="email" required>
          <div class="invalid-feedback">Please enter a valid email.</div>
        </div>
        <div class="mb-4">
          <label for="password" class="form-label">Password</label>
          <input name="password" id="password" class="form-control" type="password" autocomplete="new-password" required>
          <div class="invalid-feedback">Please choose a password.</div>
        </div>
        <button class="rn-btn rn-btn-primary rn-btn-block">Create account</button>
      </form>
    </div>
  </div>
</section>
