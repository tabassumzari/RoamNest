<footer class="rn-footer">
  <div class="container rn-container">
    <div class="rn-footer-grid">
      <div class="rn-footer-brand">
        <a class="rn-brand" href="/listings">
          <span class="rn-brand-mark"><i class="fa-regular fa-compass"></i></span>
          <span class="rn-brand-word">Roam<em>Nest</em></span>
        </a>
        <p>Luxury stays, thoughtfully curated. From beachfront villas to mountain cabins, find the place that feels like yours.</p>
      </div>
      <div>
        <h4>Explore</h4>
        <ul>
          <% (typeof categories !== "undefined" ? categories : []).slice(1, 6).forEach(function (c) { %>
            <li><a href="/listings?category=<%= c.key %>"><%= c.label %></a></li>
          <% }) %>
        </ul>
      </div>
      <div>
        <h4>Account</h4>
        <ul>
          <% if (typeof currUser !== "undefined" && currUser) { %>
            <li><a href="/wishlist">Wishlist</a></li>
            <li><a href="/listings/new">List your property</a></li>
            <li><a href="/logout">Log out</a></li>
          <% } else { %>
            <li><a href="/login">Log in</a></li>
            <li><a href="/signup">Sign up</a></li>
          <% } %>
        </ul>
      </div>
    </div>
    <div class="rn-footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> RoamNest. A portfolio project.</span>
      <span class="rn-footer-links"><a href="/privacy">Privacy</a><a href="/terms">Terms</a></span>
    </div>
  </div>
</footer>
