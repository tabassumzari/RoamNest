<% if (typeof success !== "undefined" && success && success.length) { %>
<div class="alert rn-alert rn-alert-success alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-circle-check"></i>
    <span><%= success %></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>

<% if (typeof error !== "undefined" && error && error.length) { %>
<div class="alert rn-alert rn-alert-error alert-dismissible fade show" role="alert">
    <i class="fa-solid fa-circle-exclamation"></i>
    <span><%= error %></span>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
</div>
<% } %>
